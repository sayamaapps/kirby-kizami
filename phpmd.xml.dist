<?xml version="1.0"?>
<ruleset name="Kizami"
	xmlns="http://pmd.sf.net/ruleset/1.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
	xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
	<description>PHP Mess Detector rules for Kizami (TST-10). Every exclusion and raised threshold has its reason here.</description>

	<rule ref="rulesets/cleancode.xml">
		<!-- The helper classes are static by design, as in Kirby's own code. -->
		<exclude name="StaticAccess" />
		<!-- Public flags such as withNote, merge and withYear are part of the public API (VER-3). -->
		<exclude name="BooleanArgumentFlag" />
		<!-- The assignment in a condition keeps the status cascade in reading order. -->
		<exclude name="IfStatementAssignment" />
		<!-- Early returns are not enforced; some guards read better with else. -->
		<exclude name="ElseExpression" />
		<!-- The @ operator silences warnings that the code checks afterwards (file and SQLite calls). Removing it changes what a visitor or operator sees, so it waits for a behaviour change (IDM-14). -->
		<exclude name="ErrorControlOperator" />
		<!-- Global PHP and Kirby classes are written fully qualified in several places; adding imports is cosmetic. -->
		<exclude name="MissingImport" />
	</rule>

	<rule ref="rulesets/codesize.xml/CyclomaticComplexity">
		<!-- Holidays::ids(), Schedule and the report branches branch on purpose. -->
		<properties>
			<property name="reportLevel" value="31" />
		</properties>
	</rule>
	<rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
		<!-- Analysis::data() is 191 lines. Splitting it is a follow-up; it is not changed in this step (no behaviour change). -->
		<properties>
			<property name="minimum" value="200" />
		</properties>
	</rule>
	<rule ref="rulesets/codesize.xml/ExcessiveParameterList" />

	<rule ref="rulesets/design.xml">
		<!-- The domain classes (Store, Schedule-like Report and Analysis classes) are large by design; splitting them changes the API (VER-3). -->
		<exclude name="TooManyPublicMethods" />
		<exclude name="TooManyMethods" />
		<exclude name="CouplingBetweenObjects" />
	</rule>

	<rule ref="rulesets/naming.xml">
		<!-- Short names are the formulas of the Easter algorithm and array keys in tables. -->
		<exclude name="ShortVariable" />
		<!-- I18n::t() is the translation shorthand used in snippets and tests. -->
		<exclude name="ShortMethodName" />
	</rule>

	<rule ref="rulesets/unusedcode.xml" />
</ruleset>
